rules_version = '2';

// Privacy rules for Seekho Jeeto.
//
// Every student's progress lives in its own document: users/{uid}.
// These rules make sure a signed-in student can read and write ONLY their own
// document - nobody else's data is ever readable, even if the app is modified.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
